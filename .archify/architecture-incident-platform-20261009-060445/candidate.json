  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Deterministic Parsing",
      "items": [
        "LogService (backend/app/services/log_service.py:32): Validates UTF-8 encoding, <=10MB size limits, and SHA-256 deduplication.",
        "ParserRegistry (backend/app/parsers/parser_registry.py:15): Deterministically routes to JSONLogParser or TextLogParser.",
        "Extracted structured fields: timestamp, log level, service name, exception type, message, and line-numbered stack traces."
      ]
    },
    {
      "dot": "violet",
      "title": "Correlation & Evidence-Grounded RCA",
      "items": [
        "CorrelationService (backend/app/services/correlation_service.py:30): Groups parsed logs into incidents using 30s temporal windows and cross-service traces.",
        "RootCauseAnalyzer (backend/app/rca/analyzer.py:16): Packages controlled evidence and executes multi-hypothesis reasoning.",
        "RCAValidator (backend/app/rca/validators.py:25): Strict anti-hallucination gate checking evidence citations and hypothesis grounds."
      ]
    },
    {
      "dot": "amber",
      "title": "AI Recommendations & Guardrails",
      "items": [
        "RecommendationGenerator (backend/app/recommendations/generator.py:15): Generates diagnostic actions derived strictly from validated RCA.",
        "LLM Providers (backend/app/rca/providers/llm_provider.py:18): Decoupled OpenAI/Gemini/Mock provider invoked over httpx with graceful fallback.",
        "Safety Guardrails: Rejects ungrounded shell commands, hallucinated configuration changes, and unverified fixes."
      ]
    },
    {
      "dot": "emerald",
      "title": "Developer Investigation & Resolution",
      "items": [
        "InvestigationService (backend/app/services/investigation_service.py:45): Manages developer assignment, notes, and actions.",
        "Resolution Gate (backend/app/api/v1/endpoints/incidents.py:650): Requires all verification checklist steps to pass before RESOLVED state.",
        "Audit Trail (backend/app/services/audit_service.py:10): Immutable logging of reviews, status transitions, and acting identities."
      ]
    },
    {
      "dot": "rose",
      "title": "Security, RBAC & Persistence",
      "items": [
        "Auth Layer (backend/app/api/dependencies/auth.py:12): PyJWT Bearer validation, token expiry, and Role-Based Access Control (Admin, Developer, Viewer).",
        "PostgreSQL (backend/app/core/database.py:22): ACID relational store for users, logs, incidents, RCAs, recommendations, and audit logs.",
        "No Redis or Celery: Platform executes synchronous transactional processing; no background worker queue is implemented."
      ]
    }
  ]
