# Application Environment
APP_ENV=development
APP_NAME=AI-Powered Incident Response & RCA Platform
APP_VERSION=0.1.0
DEBUG=True

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_platform_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Ingestion Settings
MAX_LOG_UPLOAD_SIZE_MB=10

# Phase 3: Incident Correlation Settings
INCIDENT_CORRELATION_WINDOW_SECONDS=30

# Phase 5: RCA Settings (use 'mock' for deterministic testing, or 'openai'/'llm' with API key)
RCA_PROVIDER=mock
RCA_MODEL=mock-rca-v1
RCA_API_KEY=
RCA_BASE_URL=

# Phase 6: Recommendation Settings (use 'mock' for deterministic testing, or 'openai'/'llm' with API key)
RECOMMENDATION_PROVIDER=mock
RECOMMENDATION_MODEL=mock-rec-v1
RECOMMENDATION_API_KEY=
RECOMMENDATION_BASE_URL=

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# API Prefix
API_V1_PREFIX=/api/v1
