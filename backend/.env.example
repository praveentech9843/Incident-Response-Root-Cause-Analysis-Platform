# ==============================================================================
# Backend Environment Configuration Template (Phase 8 Production Ready)
# Copy this file to .env in the backend directory.
# ==============================================================================

APP_ENV=development
APP_NAME=AI-Powered Incident Response & RCA Platform
APP_VERSION=0.8.0
DEBUG=False

# Security (Argon2 / JWT)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
AUTH_STRICT=False
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_platform_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Ingestion Settings
MAX_LOG_UPLOAD_SIZE_MB=10

# Phase 3: Incident Correlation Settings
INCIDENT_CORRELATION_WINDOW_SECONDS=30

# Phase 5: RCA Settings
RCA_PROVIDER=none
RCA_MODEL=none
RCA_API_KEY=
RCA_BASE_URL=

# Phase 6: Recommendation Settings
RECOMMENDATION_PROVIDER=none
RECOMMENDATION_MODEL=none
RECOMMENDATION_API_KEY=
RECOMMENDATION_BASE_URL=

# Phase 8: Integrations
GITHUB_ENABLED=False
GITHUB_TOKEN=
GITHUB_REPO=

PROMETHEUS_ENABLED=False
PROMETHEUS_URL=

KUBERNETES_ENABLED=False
KUBERNETES_NAMESPACE=default

# Phase 8: Alerting & Notifications
SLACK_ENABLED=False
SLACK_TOKEN=
SLACK_DEFAULT_CHANNEL=incidents

PAGERDUTY_ENABLED=False
PAGERDUTY_TOKEN=

EMAIL_ENABLED=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
API_V1_PREFIX=/api/v1
